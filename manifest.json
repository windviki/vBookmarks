{
	"name": "__MSG_extName__",
	"version": "4.0.9",
	"description": "__MSG_extDesc__",
	"manifest_version": 3,
	"homepage_url": "https://chrome.google.com/webstore/detail/odhjcodnoebmndcihdedenkmdmklpihb",
	"icons": {
		"16": "assets/icons/icon16.png",
		"48": "assets/icons/icon48.png",
		"128": "assets/icons/icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "assets/icons/icon16.png",
			"19": "assets/icons/icon.png",
			"32": "assets/icons/icon32.png",
			"48": "assets/icons/icon48.png",
			"128": "assets/icons/icon128.png"
		},
		"default_title": "vBookmarks",
		"default_popup": "pages/popup.html"
	},
	"options_page": "pages/options.html",
	"side_panel": {
		"default_path": "pages/sidepanel.html"
	},
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"windows": "Ctrl+Shift+V",
				"mac": "Command+Shift+V",
				"chromeos": "Ctrl+Shift+V",
				"linux": "Ctrl+Shift+V"
			}
		},
		"open-side-panel": {
			"suggested_key": {
				"default": "Alt+Shift+B"
			},
			"description": "__MSG_openSidePanelCommand__"
		},
		"open-command-palette": {
			"suggested_key": {
				"windows": "Ctrl+Shift+K",
				"mac": "Command+Shift+K",
				"chromeos": "Ctrl+Shift+K",
				"linux": "Ctrl+Shift+K"
			},
			"description": "__MSG_openCommandPaletteCommand__"
		},
		"quick-add-bookmark": {
			"suggested_key": {
				"windows": "Alt+Shift+S",
				"mac": "Command+Shift+S",
				"chromeos": "Alt+Shift+S",
				"linux": "Alt+Shift+S"
			},
			"description": "__MSG_quickAddBookmarkCommand__"
		}
	},
	"permissions": [
		"bookmarks",
		"tabs",
		"favicon",
		"storage",
		"scripting",
		"sidePanel",
		"contextMenus",
		"tabGroups",
		"alarms",
		"clipboardWrite",
		"proxy"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"_favicon/*"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"host_permissions": [
		"<all_urls>"
	],
	"optional_permissions": [
		"history"
	],
	"content_security_policy": {
		"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src *;"
	},
	"minimum_chrome_version": "114.0.0.0",
	"default_locale": "en",
	"omnibox": {
		"keyword": "*"
	}
}
