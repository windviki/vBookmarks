{
	"name": "__MSG_extName__",
	"version": "3.7",
	"description": "__MSG_extDesc__",
	"manifest_version": 3,
	"homepage_url": "https://chrome.google.com/webstore/detail/odhjcodnoebmndcihdedenkmdmklpihb",
	"icons": {
		"16": "icon16.png",
		"48": "icon48.png",
		"128": "icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "icon16.png",
			"19": "icon.png",
			"32": "icon32.png",
			"48": "icon48.png",
			"128": "icon128.png"
		},
		"default_title": "vBookmarks",
		"default_popup": "popup.html"
	},
	"options_page": "options.html",
	"side_panel": {
		"default_path": "popup.html?panel=1"
	},
	"background": {
        "service_worker": "background.js",
        "type": "module"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"windows": "Ctrl+Shift+V",
				"mac": "Command+Shift+V",
				"chromeos": "Ctrl+Shift+V",
				"linux": "Ctrl+Shift+V"
			}
		},
		"open-side-panel": {
			"suggested_key": {
				"default": "Alt+Shift+B"
			},
			"description": "__MSG_openSidePanelCommand__"
		}
	},
	"permissions": [
		"bookmarks",
		"tabs",
        "favicon",
        "storage",
        "scripting",
        "sidePanel",
        "contextMenus"
	],
    "web_accessible_resources": [{
        "resources": [ "_favicon/*" ],
        "matches": ["<all_urls>"]
    }],
    "host_permissions": [
		"<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "img-src 'self' data:; default-src 'self'; style-src 'self';"
    },
	"minimum_chrome_version": "88.0.0.0",
	"default_locale": "en",
	"omnibox": {
		"keyword": "*"
	}
}